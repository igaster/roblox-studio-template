# Built place files
*.rbxl
*.rbxlx

# Roblox Studio lock files
/*.rbxlx.lock
/*.rbxl.lock

# Rojo sourcemap (generated, not source)
sourcemap.json

# Personal Claude Code settings (MCP approvals, enabled plugins such as roblox-trainer)
.claude/settings.local.json

# Per-clone working notes and state (framework friction log, trainer session state)
/FRAMEWORK_FEEDBACK.md
/TRAINING_STATE.json

# Plan-execution scratch created by the superpowers plugin
.superpowers/

# Training archive and scenarios (owner answers; the Lead is denied reading them)
/.training/

# Training records: notes from observing one game's run stay local (the ledger has its own
# .ledger/.gitignore)
/docs/superpowers/specs/*-run-findings.md

# Python bytecode (trainer scripts)
__pycache__/

# Games: each games/<name>/ is its own git repo (scripts/new-game.sh); the framework repo
# never tracks them
/games/

# Per-clone framework-root state (active game, last visit)
/.local/
